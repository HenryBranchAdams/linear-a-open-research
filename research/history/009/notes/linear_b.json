  "claims": [
    {
      "id": "LBC01",
      "claim": "ta-na-to is a securely edited complete designation in a person-name/flock-responsibility position, rather than the following place or upper collector position",
      "status": "supported within Linear B",
      "basis": [
        "LB01",
        "LB02",
        "LB03",
        "LB04",
        "LB_CIVITILLO2025",
        "LB_GRECO2010"
      ],
      "limitations": [
        "personal name/type does not identify same historical person in Linear A",
        "flock responsibility does not prove legal ownership or literal shepherd occupation"
      ]
    },
    {
      "id": "LBC02",
      "claim": "TA-NA-TI in Linear A is the same lexeme or individual as TA-NA-TE/A-TA-NA-TE",
      "status": "not established",
      "basis": [
        "LB01",
        "LB05"
      ],
      "strongest_counterargument": "The external LB comparanda do not connect the complete LA forms independently; related names, distinct names and regional/grammatical variants survive."
    },
    {
      "id": "LBC03",
      "claim": "KN Uf311 supplies a complete homographic ta-na-ti personal name",
      "status": "rejected as stated",
      "basis": [
        "LB05"
      ],
      "reason": "The left boundary is missing and the original object is lost."
    },
    {
      "id": "LBC04",
      "claim": "LB ta-na-to / ]ta-na-ti is an ordinary o-stem nominative/dative opposition",
      "status": "rejected conditionally on ordinary Greek o-stem analysis",
      "basis": [
        "LB01",
        "LB05",
        "LB_MELENA2014"
      ],
      "reason": "The i of final oi is normally omitted; both expected forms would be written with final to. Another stem or formation would require evidence."
    },
    {
      "id": "LBC05",
      "claim": "Independent correspondence controls uniquely privilege final i→o over e→o",
      "status": "not supported",
      "basis": [
        "LB06",
        "LB07",
        "LB08",
        "LB09",
        "LB_CIVITILLO2025"
      ],
      "reason": "Published adaptation comparisons include e/u/i; e/o and u/o examples have independently checked LB contexts. Candidate pairs are not securely calibrated sound laws."
    },
    {
      "id": "LBC06",
      "claim": "ta-na-to has securely established non-Greek etymology",
      "status": "not established",
      "basis": [
        "LB_MELENA2014",
        "LB_DAVIS_VALERIO2020"
      ],
      "reason": "Melena p112 gives a doubly questioned /Thnatos/ analysis; this does not establish that reading but prevents treating non-Greek origin as an uncontested independent premise."
    }
  ],
